 application "MediaVault"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Content
		{
			success message = "Content Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have unique Content_ID
			(
    			type = text
				displayname = "Content ID"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Title
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Content_Type
			(
				type = picklist
				displayname = "Content Type"
				maxchar = 100
				values = {"Movie","Song","Web Series","Music Video","Documentery"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Content_Type1
			(
				type = picklist
				displayname = "Language"
				maxchar = 100
				values = {"English","Tamil","Hindi","Telugu","Kannada"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Release_Year
			(
				type = number
				displayname = "Release Year"
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Rights_Status
			(
				type = picklist
				displayname = "Rights Status"
				maxchar = 100
				values = {"Available","Licensed","Restricted","Expired"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Description
			(
    			type = textarea
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			Ownership_Status
			(
				type = picklist
				displayname = "Ownership Status"
				maxchar = 100
				values = {"Pending","Partially Verified","Verified","Rejected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Rights_Ownership
			(
				type = grid
				displayname = "Rights Ownership"
				must have Rights_Holders
				(
					type = picklist	
					displayname = "Rights Holders"
					values  = Rights_Holders.ID
    				displayformat = [Rights_Holder_ID]
					sortorder = ascending
					width = medium
				)
				must have Ownership_Percentage
				(
					type = decimal
					displayname = "Ownership Percentage"
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Content_Ownership
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Content
			(
				type = picklist	
				values  = Content.ID
    			displayformat = [Title]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Rights_Holders
			(
				type = picklist	
				displayname = "Rights Holders"
				values  = Rights_Holders.ID
    			displayformat = [Name]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Ownership_Percentage
			(
				type = decimal
				displayname = "Ownership Percentage"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Verification_Status
			(
				type = picklist
				displayname = "Verification Status"
				maxchar = 100
				values = {"Verified","Pending","Rejected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Supporting_Document
			(
    			type = upload file
				displayname = "Supporting Document"
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Verified_By
			(
    			type = text
				displayname = "Verified By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			Verification_Date
			(
    			type = date
				displayname = "Verification Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
