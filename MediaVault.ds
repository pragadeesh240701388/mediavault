			W3b_Workflow as "3b. Workflow"
			{
				type =  form
				form = Content_Ownership

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											isAdmin = zoho.loginuser == zoho.adminuser;
										errorMsg = "";
										savedStatus = "Pending";
										if(input.ID != null)
										{
											saved = Content_Ownership[ID == input.ID];
											savedStatus = saved.Verification_Status;
										}
										if(input.Ownership_Percentage == null || input.Ownership_Percentage <= 0 || input.Ownership_Percentage > 100)
										{
											errorMsg = "Ownership percentage must be between 0.01 and 100.";
										}
										// Only the administrator can change the status
										if(errorMsg == "" && !isAdmin)
										{
											if(input.ID == null)
											{
												input.Verification_Status = "Pending";
											}
											else if(savedStatus == "Verified")
											{
												errorMsg = "Verified ownership is locked. Ask an administrator to change it.";
											}
											else
											{
												input.Verification_Status = savedStatus;
											}
										}
										// One claim per holder per content
										// One claim per holder per content
										if(errorMsg == "")
										{
											for each  p in Content_Ownership[Content == input.Content && Rights_Holders == input.Rights_Holders && Verification_Status != "Rejected"]
											{
												if(input.ID == null || p.ID != input.ID)
												{
													errorMsg = "This rights holder already has an ownership claim for this content.";
												}
											}
										}
										// Verified shares for one content can never exceed 100%
										if(errorMsg == "" && input.Verification_Status == "Verified")
										{
											total = input.Ownership_Percentage;
											for each  p in Content_Ownership[Content == input.Content && Verification_Status == "Verified"]
											{
												if(input.ID == null || p.ID != input.ID)
												{
													total = total + p.Ownership_Percentage;
												}
											}
											if(total > 100.0001)
											{
												errorMsg = "Verified ownership for this content would total " + total + "%. It cannot exceed 100%.";
											}
										}
										if(errorMsg != "")
										{
											alert errorMsg;
											cancel submit;
										}
										else
										{
											if(input.Verification_Status == "Verified" && savedStatus != "Verified")
											{
												input.Verified_By = zoho.loginuser;
												input.Verification_Date = zoho.currentdate;
											}
											else if(input.Verification_Status != "Verified")
											{
												input.Verified_By = "";
												input.Verification_Date = null;
											}
										}
						)
					}
				}

			}
