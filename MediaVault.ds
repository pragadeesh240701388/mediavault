	pages
	{
		page MediaVault_Dashboard
		{
			displayname = "MediaVault Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = '#333333'\n\tsize = '16px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'MEDIAVAULT DASHBOARD'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Active_Licenses'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<report \n\telementName='Report 1'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'Rights_Violations_Report'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Revenue by Platform'\n\n\ttype = 'Bar'\n\txtitle = 'Platform'\n\tytitle = 'Revenue Amount'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Revenue'\n\txfield = 'Platform'\n\tyfields = 'sum:Revenue_Amount'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='50%'\n   \t>\n\t<report \n\telementName='Report 2'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'All_Royalty_Payments'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column><column\n   \t\t width='50%'\n   \t>\n\t<report \n\telementName='Report 3'\n\n\t\tappLinkName = 'thisapp'\n\t\tlinkName = 'All_Distribution_Requests'\n\t\n\t\tiszreport = 'false'\n\theightType = 'auto'\n\theightValue = '700'\n/>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet' elementName='HTML Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet()\ncontent\n&lt;%{\n\topenViol = Rights_Violations[Violation_Status == &quot;Open&quot;].count();\n\tcritical = Rights_Violations[Severity == &quot;Critical&quot; &amp;&amp; Violation_Status == &quot;Open&quot;].count();\n\tpendingClaims = Content_Ownership[Verification_Status == &quot;Pending&quot;].count();\n\tactiveLic = Licenses[License_Status == &quot;Active&quot; &amp;&amp; License_End_Date &gt;= zoho.currentdate].count();\n\texpiring = Licenses[License_Status == &quot;Active&quot; &amp;&amp; License_End_Date &gt;= zoho.currentdate &amp;&amp; License_End_Date &lt;= zoho.currentdate.addDay(30)].count();\n\tpendingReq = Distribution_Requests[Request_Status == &quot;Pending&quot;].count();\n\t%&gt;\n&lt;style&gt;\n.mv-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(160px,1fr));gap:14px;padding:8px}\n.mv-card{background:#fff;border:1px solid #e6e8ee;border-left:5px solid #4f46e5;border-radius:12px;padding:16px 18px;font-family:sans-serif}\n.mv-card b{display:block;font-size:32px;color:#1b1f3b}\n.mv-card span{font-size:13px;color:#6b7280}\n.mv-red{border-left-color:#dc2626}.mv-amber{border-left-color:#f59e0b}.mv-green{border-left-color:#16a34a}\n&lt;/style&gt;\n&lt;div class=&quot;mv-grid&quot;&gt;\n&lt;div class=&quot;mv-card mv-red&quot;&gt;&lt;b&gt;&lt;%=openViol%&gt;&lt;/b&gt;&lt;span&gt;Open violations&lt;/span&gt;&lt;/div&gt;\n&lt;div class=&quot;mv-card mv-red&quot;&gt;&lt;b&gt;&lt;%=critical%&gt;&lt;/b&gt;&lt;span&gt;Critical (open)&lt;/span&gt;&lt;/div&gt;\n&lt;div class=&quot;mv-card mv-amber&quot;&gt;&lt;b&gt;&lt;%=pendingClaims%&gt;&lt;/b&gt;&lt;span&gt;Ownership claims pending&lt;/span&gt;&lt;/div&gt;\n&lt;div class=&quot;mv-card mv-green&quot;&gt;&lt;b&gt;&lt;%=activeLic%&gt;&lt;/b&gt;&lt;span&gt;Active licenses&lt;/span&gt;&lt;/div&gt;\n&lt;div class=&quot;mv-card mv-amber&quot;&gt;&lt;b&gt;&lt;%=expiring%&gt;&lt;/b&gt;&lt;span&gt;Expiring within 30 days&lt;/span&gt;&lt;/div&gt;\n&lt;div class=&quot;mv-card&quot;&gt;&lt;b&gt;&lt;%=pendingReq%&gt;&lt;/b&gt;&lt;span&gt;Requests pending&lt;/span&gt;&lt;/div&gt;\n&lt;/div&gt;\n&lt;%\n\n}%&gt;]]>\n</dsp>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}


		 functions
		 {
			 Deluge
			 {
				 void explainViolation(int violationRecID)
                 {
                 	v = Rights_Violations[ID == violationRecID];
                 	if(v.count() == 0)
                 	{
                 		return;
                 	}
                 	req = Distribution_Requests[ID == v.Distribution_Requests.toLong()];
                 	cont = Content[ID == v.Content.toLong()];
                 	// Facts only. No emails, phone numbers or personal names.
                 	facts = "Content: " + cont.Title + ". Territory requested: " + v.Territory;
                 	if(req.count() > 0)
                 	{
                 		facts = facts + ". Requested period: " + req.Requested_Start_Date.toString("dd-MMM-yyyy") + " to " + req.Requested_End_Date.toString("dd-MMM-yyyy");
                 	}
                 	facts = facts + ". Severity: " + v.Severity + ". System reason: " + v.Reason;
                 	prompt = "You write short notices for a media licensing system. Using ONLY the facts below, write 2 to 3 plain sentences. Sentence 1: say what was requested and why it was refused, using only the license ID and dates given. Sentence 2: the next step. The only next steps you may suggest are: (a) ask the rights owner to extend or renew the license, (b) request a license for the missing territory, or (c) resubmit with dates inside the licensed period. Do not mention authorities, deadlines, urgency, penalties, legal advice or any person or organisation not named in the facts. Do not invent license numbers or dates, and do not change the severity. Facts: " + facts;
                 	try 
                 	{
                 		response = zia
                 		[
                 			message:prompt
                 		];
                 		v.AI_Explanation="AI-generated summary. The stored Reason and Severity are the official result. " + response.toString();
                 	}	catch (e)
                 	{
                 		v.AI_Explanation="AI explanation unavailable: " + e;
                 	}
                 }
				 map Fetch_License_Records()
                 {
                 	todayDate = zoho.currentdate;
                 	result = List();
                 	for each  lic in Licenses[ID != 0]
                 	{
                 		state = "Not Active (" + lic.License_Status + ")";
                 		if(lic.License_Status == "Active")
                 		{
                 			if(lic.License_End_Date != null && lic.License_End_Date < todayDate)
                 			{
                 				state = "Expired";
                 			}
                 			else if(lic.License_Start_Date != null && lic.License_Start_Date > todayDate)
                 			{
                 				state = "Not Started";
                 			}
                 			else if(lic.License_End_Date != null && lic.License_End_Date <= todayDate.addDay(30))
                 			{
                 				state = "Expiring Soon";
                 			}
                 			else
                 			{
                 				state = "Valid";
                 			}
                 		}
                 		endText = "";
                 		if(lic.License_End_Date != null)
                 		{
                 			endText = lic.License_End_Date.toString("dd-MMM-yyyy");
                 		}
                 		item = Map();
                 		item.put("License_ID",lic.License_ID);
                 		item.put("Licensee_Name",lic.Licensee_Name);
                 		item.put("Territory",lic.Territory);
                 		item.put("License_Status",lic.License_Status);
                 		item.put("License_End_Date",endText);
                 		item.put("Coverage_State",state);
                 		result.add(item);
                 	}
                 	response = Map();
                 	response.put("status","success");
                 	response.put("count",result.size());
                 	response.put("licenses",result);
                 	return response;
                 }
			 }
		 }


		workflow
		{
		form
		{
			Check_Distribution_Rights as "Check Distribution Rights"
			{
				type =  form
				form = Distribution_Requests

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// ===== Configuration =====
										expiryWarningDays = 30;
										createAdvisoryRecords = false;
										// true = also log Medium/Low as violation records
										// ===== Working variables =====
										today = zoho.currentdate;
										startTxt = input.Requested_Start_Date.toString("dd-MMM-yyyy");
										endTxt = input.Requested_End_Date.toString("dd-MMM-yyyy");
										matchCount = 0;
										solidCover = false;
										nearCover = false;
										nearLicenseID = "";
										nearEndText = "";
										issueText = "";
										adminIssue = "";
										// ===== Evaluate every license for this content =====
										for each  lic in Licenses[Content == input.Content]
										{
											if(lic.Territory == input.Requested_Territory || lic.Territory == "Worldwide")
											{
												matchCount = matchCount + 1;
												statusOK = lic.License_Status == "Active";
												datesOK = false;
												if(lic.License_Start_Date != null && lic.License_End_Date != null)
												{
													if(lic.License_Start_Date <= input.Requested_Start_Date && lic.License_End_Date >= input.Requested_End_Date)
													{
														datesOK = true;
													}
												}
												if(statusOK && datesOK)
												{
													if(lic.License_End_Date <= today.addDay(expiryWarningDays))
													{
														nearCover = true;
														nearLicenseID = lic.License_ID;
														nearEndText = lic.License_End_Date.toString("dd-MMM-yyyy");
													}
													else
													{
														solidCover = true;
													}
													if(lic.Royalty_Percentage == null)
													{
														adminIssue = adminIssue + "License " + lic.License_ID + " has no royalty percentage recorded. ";
													}
												}
												else
												{
													problem = "License " + lic.License_ID + ": ";
													if(!statusOK)
													{
														problem = problem + "status is " + lic.License_Status + ". ";
													}
													if(!datesOK)
													{
														if(lic.License_Start_Date == null || lic.License_End_Date == null)
														{
															problem = problem + "license dates are missing. ";
														}
														else
														{
															problem = problem + "license period " + lic.License_Start_Date.toString("dd-MMM-yyyy") + " to " + lic.License_End_Date.toString("dd-MMM-yyyy") + " does not cover the requested period " + startTxt + " to " + endTxt + ". ";
														}
													}
													issueText = issueText + problem;
												}
											}
										}
										// ===== Classify =====
										severity = "";
										newStatus = "";
										reason = "";
										notes = "";
										if(solidCover || nearCover)
										{
											newStatus = "Approved";
											if(input.Expected_Revenue == null)
											{
												adminIssue = adminIssue + "Expected revenue is not entered. ";
											}
											else if(input.Expected_Revenue <= 0)
											{
												adminIssue = adminIssue + "Expected revenue is zero or negative. ";
											}
											if(!solidCover && nearCover)
											{
												severity = "Medium";
												reason = "Covered by license " + nearLicenseID + ", which expires on " + nearEndText + " (within " + expiryWarningDays.toString() + " days).";
												notes = "MEDIUM: Rights coverage is valid but the license is nearing expiry. Plan a renewal.";
											}
											else if(adminIssue != "")
											{
												severity = "Low";
												reason = "Rights coverage confirmed, but: " + adminIssue;
												notes = "LOW: Administrative follow-up only. No rights-coverage failure.";
											}
										}
										else if(matchCount == 0)
										{
											newStatus = "Rights Violation";
											severity = "Critical";
											reason = "No license exists for this content in the requested territory (" + input.Requested_Territory + ") for " + startTxt + " to " + endTxt + ".";
											notes = "CRITICAL: No license covers this territory. Escalate to the rights/legal team before any release.";
										}
										else
										{
											newStatus = "Rights Violation";
											severity = "High";
											reason = "A license exists for the requested territory but it cannot support this request. " + issueText;
											notes = "HIGH: Review the license status and dates. Reactivate, renew or amend the license, or reduce the requested period.";
										}
										// ===== Update the request =====
										req = Distribution_Requests[ID == input.ID];
										req.Request_Status=newStatus;
										if(newStatus == "Rights Violation")
										{
											req.Remarks="Rights Violation (" + severity + "): " + reason;
										}
										else if(severity != "")
										{
											req.Remarks="Approved with " + severity + " advisory: " + reason;
										}
										else
										{
											req.Remarks="Approved: an active license covers the requested territory and distribution period.";
										}
										// ===== Create the violation record (once per request) =====
										createRecord = false;
										if(newStatus == "Rights Violation")
										{
											createRecord = true;
										}
										else if(severity != "" && createAdvisoryRecords)
										{
											createRecord = true;
										}
										if(createRecord)
										{
											existing = Rights_Violations[Distribution_Requests == input.ID];
											if(existing.count() == 0)
											{
												insert into Rights_Violations
												[
													Violation_ID="VIO-" + input.Request_ID
													Distribution_Requests=input.ID
													Content=input.Content
													Territory=input.Requested_Territory
													Violation_Date=zoho.currentdate
													Reason=reason
													Severity=severity
													Violation_Status="Open"
													Notes=notes
													Added_User=zoho.loginuser
												]
											}
										}
										for each  v in Rights_Violations[Distribution_Requests == input.ID]
										{
											thisapp.explainViolation(v.ID);
										}
						)
					}
				}

			}
			License_Expiry_Alert as "License Expiry Alert"
			{
				type =  form
				form = Licenses

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// On success, changes to input are not saved, so update the stored record
										lic = Licenses[ID == input.ID];
										if(lic.License_End_Date != null)
										{
											if(lic.License_End_Date < zoho.currentdate)
											{
												lic.License_Status="Expired";
											}
											else if(lic.License_End_Date <= zoho.currentdate.addDay(30))
											{
												warn = "Warning: This license expires within 30 days.";
												if(lic.License_Notes == null || lic.License_Notes == "")
												{
													lic.License_Notes=warn;
												}
												else if(!lic.License_Notes.contains(warn))
												{
													lic.License_Notes=lic.License_Notes + " | " + warn;
												}
											}
										}
						)
					}
				}

			}
