			Calculate_Royalty_Validat as "Calculate Royalty Validate"
			{
				type =  form
				form = Royalty_Payments

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Paid payments are locked: restore the saved values
										paidLocked = false;
										if(input.ID != null)
										{
											saved = Royalty_Payments[ID == input.ID];
											if(saved.Payment_Status == "Paid")
											{
												paidLocked = true;
												input.Revenue_Amount = saved.Revenue_Amount;
												input.Royalty_Percentage = saved.Royalty_Percentage;
												input.Royalty_Amount = saved.Royalty_Amount;
												input.Payment_Status = "Paid";
											}
										}
										if(!paidLocked)
										{
											errorMsg = "";
											if(input.Revenue_Amount == null || input.Revenue_Amount <= 0)
											{
												errorMsg = "Revenue Amount must be greater than 0.";
											}
											else if(input.Royalty_Percentage == null || input.Royalty_Percentage < 0 || input.Royalty_Percentage > 100)
											{
												errorMsg = "Royalty Percentage must be between 0 and 100.";
											}
											// Prevent double-counting (skipped for Cancelled payments)
											if(errorMsg == "" && input.Payment_Status != "Cancelled")
											{
												if(input.Rights_Holders != null)
												{
													dupCount = Royalty_Payments[Revenue == input.Revenue && Rights_Holders == input.Rights_Holders && Payment_Status != "Cancelled"].count();
													allowed = 0;
													if(input.ID != null)
													{
														allowed = 1;
													}
													if(dupCount > allowed)
													{
														errorMsg = "This rights holder already has a payment for this revenue record.";
													}
												}
												if(errorMsg == "")
												{
													totalPct = input.Royalty_Percentage;
													for each  p in Royalty_Payments[Revenue == input.Revenue && Payment_Status != "Cancelled"]
													{
														if(input.ID == null || p.ID != input.ID)
														{
															totalPct = totalPct + p.Royalty_Percentage;
														}
													}
													if(totalPct > 100)
													{
														errorMsg = "Royalty percentages for this revenue add up to more than 100%.";
													}
												}
											}
											if(errorMsg != "")
											{
												alert errorMsg;
												cancel submit;
											}
											else
											{
												input.Royalty_Amount = (input.Revenue_Amount * input.Royalty_Percentage / 100).round(2);
												if(input.Payment_Status == null || input.Payment_Status == "" || input.Payment_Status == "Pending")
												{
													input.Payment_Status = "Calculated";
												}
												if(input.Payment_Status == "Paid" && input.Payment_Date == null)
												{
													input.Payment_Date = zoho.currentdate;
												}
											}
										}
						)
					}
				}

			}
