			crm as "crm"
			{
				type =  form
				form = Licenses

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											deal = Map();
										deal.put("Deal_Name","License " + input.License_ID + " - " + input.Licensee_Name);
										deal.put("Amount",input.License_Fee);
										deal.put("Closing_Date",input.License_Start_Date.toString("yyyy-MM-dd"));
										deal.put("Stage","Closed Won");
										resp = zoho.crm.createRecord("Deals",deal,Map(),"zoho_crm_connection");
						)
					}
				}

			}
		}






