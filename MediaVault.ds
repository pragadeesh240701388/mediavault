			W3f_Workflow as "3f. Workflow"
			{
				type =  form
				form = Licenses

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											if(input.License_Status == "Active")
										{
											c = Content[ID == input.Content];
											if(c.Ownership_Status != "Verified")
											{
												alert "Cannot activate this license: ownership of this content is not verified yet.";
												cancel submit;
											}
										}
						)
					}
				}

			}
			W3c as "3c"
			{
				type =  form
				form = Content_Ownership

				record event = on add or edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											verifiedTotal = 0.0;
										pendingCount = 0;
										rowCount = 0;
										for each  p in Content_Ownership[Content == input.Content]
										{
											rowCount = rowCount + 1;
											if(p.Verification_Status == "Verified")
											{
												verifiedTotal = verifiedTotal + p.Ownership_Percentage;
											}
											else if(p.Verification_Status == "Pending")
											{
												pendingCount = pendingCount + 1;
											}
										}
										newStatus = "Pending";
										if(verifiedTotal >= 99.995 && verifiedTotal <= 100.005)
										{
											newStatus = "Verified";
										}
										else if(verifiedTotal > 0)
										{
											newStatus = "Partially Verified";
										}
										else if(rowCount > 0 && pendingCount == 0)
										{
											newStatus = "Rejected";
										}
										c = Content[ID == input.Content];
										c.Ownership_Status=newStatus;
						)
					}
				}

			}
